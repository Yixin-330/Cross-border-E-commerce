# ── LLM Provider ──
# anthropic | deepseek
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# DeepSeek (used when LLM_PROVIDER=deepseek)
# OpenAI-compatible API; set the model ID available in your console.
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Disable JSON mode only if the selected model does not support it.
DEEPSEEK_JSON_MODE=1

# Shared LLM settings
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# Server configuration
PORT=8000
HOST=0.0.0.0

# Knowledge Agent (RAG bridge to rag-spike)
# Python executable of the embedding venv; defaults to rag-spike/.venv-embed.
# RAG_PYTHON=D:/Projects/sea-ai-selector/rag-spike/.venv-embed/Scripts/python.exe
# Enable cross-encoder rerank (1=on, 0=off)
KNOWLEDGE_RERANK=1
# KNOWLEDGE_RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
# Retrieval subprocess timeout (seconds). The first rerank run downloads ~0.57GB.
KNOWLEDGE_TIMEOUT=300
