{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SelectionAnswer",
  "description": "合规与选品助手的最终输出契约。所有结论必须可追溯到证据。",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["推荐", "谨慎", "不建议", "信息不足"],
      "description": "整体结论"
    },
    "summary": {
      "type": "string",
      "description": "面向用户的简要结论，不得包含证据之外的事实"
    },
    "evidence": {
      "type": "array",
      "description": "支撑结论的证据列表，每条至少对应一份检索到的文档",
      "items": {
        "type": "object",
        "properties": {
          "claim": {"type": "string", "description": "被证据支撑的具体结论"},
          "doc_id": {"type": "string", "description": "引用应落回的原文文档 ID（译文回链 original_doc_id）"},
          "source_title": {"type": "string"},
          "section_path": {"type": "string", "description": "章节路径"},
          "clause_id": {"type": "string", "description": "条款编号"},
          "page": {"type": "integer", "description": "PDF 页码，用于引用定位"},
          "published_at": {"type": "string", "description": "发布日期"},
          "effective_from": {"type": "string", "description": "生效日期；判断时效以此为准"},
          "effective_to": {"type": "string", "description": "失效日期，unknown 表示未知"},
          "collected_at": {"type": "string", "description": "采集时间，仅说明数据获取时间"},
          "source_url": {"type": "string"},
          "quote": {"type": "string", "description": "原文摘录，可选"}
        },
        "required": ["claim", "doc_id"]
      }
    },
    "compliance_checklist": {
      "type": "array",
      "description": "目标市场的准入/认证检查项",
      "items": {
        "type": "object",
        "properties": {
          "item": {"type": "string"},
          "status": {"type": "string", "enum": ["已满足", "可确认", "需人工复核"]},
          "basis_doc_ids": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string"}
        },
        "required": ["item", "status"]
      }
    },
    "profit_estimate": {
      "type": "object",
      "description": "可选的利润测算，数值来自数据工具而非检索",
      "properties": {
        "currency": {"type": "string"},
        "unit_profit": {"type": "number"},
        "margin_pct": {"type": "number"},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "unknowns": {
      "type": "array",
      "description": "证据未覆盖、需要人工确认或补充检索的事项",
      "items": {"type": "string"}
    },
    "follow_up_questions": {
      "type": "array",
      "description": "信息不足时应向用户提出的澄清问题",
      "items": {"type": "string"}
    }
  },
  "required": ["verdict", "summary", "evidence", "compliance_checklist", "unknowns"]
}
